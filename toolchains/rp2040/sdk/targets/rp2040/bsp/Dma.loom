# Loom RP2040 BSP — 12-Channel DMA Controller with Zero-Copy Ownership Safety
Module Dma
Import RP2040

Enum Dma_Channel : Unsigned_32
    Channel_0 = 0
    Channel_1 = 1
    Channel_2 = 2
    Channel_3 = 3
    Channel_4 = 4
    Channel_5 = 5
    Channel_6 = 6
    Channel_7 = 7
    Channel_8 = 8
    Channel_9 = 9
    Channel_10 = 10
    Channel_11 = 11
End Dma_Channel

Enum Dreq : Unsigned_32
    DREQ_PIO0_TX0 = 0
    DREQ_PIO0_TX1 = 1
    DREQ_PIO0_TX2 = 2
    DREQ_PIO0_TX3 = 3
    DREQ_PIO0_RX0 = 4
    DREQ_PIO0_RX1 = 5
    DREQ_PIO0_RX2 = 6
    DREQ_PIO0_RX3 = 7
    DREQ_PIO1_TX0 = 8
    DREQ_PIO1_TX1 = 9
    DREQ_PIO1_TX2 = 10
    DREQ_PIO1_TX3 = 11
    DREQ_PIO1_RX0 = 12
    DREQ_PIO1_RX1 = 13
    DREQ_PIO1_RX2 = 14
    DREQ_PIO1_RX3 = 15
    DREQ_SPI0_TX  = 16
    DREQ_SPI0_RX  = 17
    DREQ_SPI1_TX  = 18
    DREQ_SPI1_RX  = 19
    DREQ_UART0_TX = 20
    DREQ_UART0_RX = 21
    DREQ_UART1_TX = 22
    DREQ_UART1_RX = 23
    DREQ_PWM_WRAP0 = 24
    DREQ_I2C0_TX  = 32
    DREQ_I2C0_RX  = 33
    DREQ_I2C1_TX  = 34
    DREQ_I2C1_RX  = 35
    DREQ_ADC      = 36
    DREQ_FORCE    = 63
End Dreq

Enum Dma_Error : Signed_32
    Err_Invalid_Channel = -1
    Err_Busy = -2
End Dma_Error

Block Init
Implements
    RP2040.Unreset_Wait(RP2040.RESET_DMA)
End Init

Block Channel_Base Takes
    Ch : Unsigned_32
Produces Unsigned_32
Implements
    Give RP2040.DMA_BASE + (Ch * 0x40)
End Channel_Base

Block Is_Busy_Id Takes
    Ch : Unsigned_32
Produces Boolean
Declares
    Ch_Addr : Unsigned_32
Implements
    If Ch > 11
        Give False
    End If
    Ch_Addr = Channel_Base(Ch)
    Give (RP2040.Reg_Read(Ch_Addr + 0x0C) & 0x01000000) != 0
End Is_Busy_Id

Block Wait_Complete Takes
    Ch : Unsigned_32
Implements
    Loop while (Is_Busy_Id(Ch))
    End Loop
End Wait_Complete

Block Wait_Id Takes
    Ch : Unsigned_32
Implements
    Wait_Complete(Ch)
End Wait_Id

Block Abort_Id Takes
    Ch : Unsigned_32
Declares
    Abort_Reg : Unsigned_32 = 0x50000444
Implements
    If Ch <= 11
        RP2040.Reg_Write(Abort_Reg, 1 LSL Ch)
        Wait_Complete(Ch)
    End If
End Abort_Id

Block Transmit Takes
    Ch : Unsigned_32
    Buf_Addr : Unsigned_32
    Count : Unsigned_32
    Dreq_Val : Dreq
Produces Signed_32
Declares
    Ch_Addr : Unsigned_32
    Ctrl : Unsigned_32
Implements
    If Ch > 11
        Give -1
    End If
    Wait_Complete(Ch)
    Ch_Addr = Channel_Base(Ch)
    RP2040.Reg_Write(Ch_Addr + 0x00, Buf_Addr)
    RP2040.Reg_Write(Ch_Addr + 0x04, 0x4003C000 + 0x08)
    RP2040.Reg_Write(Ch_Addr + 0x08, Count)

    Ctrl = 1 | (0 LSL 2) | (1 LSL 4) | (0 LSL 5) | ((Dreq_Val as Unsigned_32) LSL 15) | (Ch LSL 11)
    RP2040.Reg_Write(Ch_Addr + 0x0C, Ctrl)
    Give 0
End Transmit

Block Receive Takes
    Ch : Unsigned_32
    Buf_Addr : Unsigned_32
    Count : Unsigned_32
    Dreq_Val : Dreq
Produces Signed_32
Declares
    Ch_Addr : Unsigned_32
    Ctrl : Unsigned_32
Implements
    If Ch > 11
        Give -1
    End If
    Wait_Complete(Ch)
    Ch_Addr = Channel_Base(Ch)
    RP2040.Reg_Write(Ch_Addr + 0x00, 0x4003C000 + 0x08)
    RP2040.Reg_Write(Ch_Addr + 0x04, Buf_Addr)
    RP2040.Reg_Write(Ch_Addr + 0x08, Count)

    Ctrl = 1 | (0 LSL 2) | (0 LSL 4) | (1 LSL 5) | ((Dreq_Val as Unsigned_32) LSL 15) | (Ch LSL 11)
    RP2040.Reg_Write(Ch_Addr + 0x0C, Ctrl)
    Give 0
End Receive

Block Transfer_32 Takes
    Channel : Unsigned_32
    Read_Addr : Unsigned_32
    Write_Addr : Unsigned_32
    Word_Count : Unsigned_32
    Incr_Read : Boolean
    Incr_Write : Boolean
Produces Signed_32 or Dma_Error
Declares
    Ch_Addr : Unsigned_32
    Ctrl : Unsigned_32
Implements
    If Channel > 11
        Give Dma_Error.Err_Invalid_Channel
    End If
    Ch_Addr = Channel_Base(Channel)
    RP2040.Reg_Write(Ch_Addr + 0x00, Read_Addr)
    RP2040.Reg_Write(Ch_Addr + 0x04, Write_Addr)
    RP2040.Reg_Write(Ch_Addr + 0x08, Word_Count)

    Ctrl = 1 | (2 LSL 2) | (Channel LSL 11) | (0x3F LSL 15)
    If Incr_Read
        Ctrl = Ctrl | (1 LSL 4)
    End If
    If Incr_Write
        Ctrl = Ctrl | (1 LSL 5)
    End If
    RP2040.Reg_Write(Ch_Addr + 0x0C, Ctrl)
    Give 0
End Transfer_32

Block Chain Takes
    Ch : Unsigned_32
    Next_Ch : Unsigned_32
Declares
    Ch_Addr : Unsigned_32
    Ctrl : Unsigned_32
Implements
    If Ch <= 11
        If Next_Ch <= 11
            Ch_Addr = Channel_Base(Ch)
            Ctrl = RP2040.Reg_Read(Ch_Addr + 0x0C)
            Ctrl = (Ctrl & ~(0x0F LSL 11)) | (Next_Ch LSL 11)
            RP2040.Reg_Write(Ch_Addr + 0x0C, Ctrl)
        End If
    End If
End Chain

Tagged Record Dma_Chan
    Id : Unsigned_32
End Dma_Chan

Block Is_Busy Takes
    This : Dma_Chan
Produces Boolean
Implements
    Give Is_Busy_Id(This.Id)
End Is_Busy

Block Abort Takes
    This : Dma_Chan
Implements
    Abort_Id(This.Id)
End Abort

Block Wait Takes
    This : Dma_Chan
Implements
    Wait_Id(This.Id)
End Wait

Block Global
    Declares
        Ch0  : Constant Dma_Chan = Dma_Chan { Id : 0 }
        Ch1  : Constant Dma_Chan = Dma_Chan { Id : 1 }
        Ch2  : Constant Dma_Chan = Dma_Chan { Id : 2 }
        Ch3  : Constant Dma_Chan = Dma_Chan { Id : 3 }
        Ch4  : Constant Dma_Chan = Dma_Chan { Id : 4 }
        Ch5  : Constant Dma_Chan = Dma_Chan { Id : 5 }
        Ch6  : Constant Dma_Chan = Dma_Chan { Id : 6 }
        Ch7  : Constant Dma_Chan = Dma_Chan { Id : 7 }
        Ch8  : Constant Dma_Chan = Dma_Chan { Id : 8 }
        Ch9  : Constant Dma_Chan = Dma_Chan { Id : 9 }
        Ch10 : Constant Dma_Chan = Dma_Chan { Id : 10 }
        Ch11 : Constant Dma_Chan = Dma_Chan { Id : 11 }
End Global
