Module SimpleServer
Import HttpServer
use HttpServer

Block Main Declares
    Host_Str : Text
    Cfg : Server_Config
    S : Server
    Client_Fd : Signed_32
    Req : Request
    Res : Response_Writer
    Raw_Msg : Text
    Status : Signed_32
Implements
    Host_Str += "127.0.0.1"
    Cfg.Host = Move Host_Str
    Cfg.Port = 9090
    Cfg.Backlog = 64
    Cfg.Timeout_Ms = 3000

    S = HttpServer.Server_New(Cfg)
    S = HttpServer.Server_Start(S)
    Print("Loom HTTP Server running on http://127.0.0.1:9090\n")

    Status = HttpServer.Server_Close(S)
    Print("Server closed successfully.\n")
End Main
