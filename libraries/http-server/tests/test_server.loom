Module TestServer
Import HttpServer
use HttpServer

Block Main Declares
    Raw_Req : Text
    Req : Request
    Res : Response_Writer
    Exp_Method : Text
    Exp_Path : Text
    Exp_Query : Text
Implements
    Exp_Method += "POST"
    Exp_Path += "/api/v1/users"
    Exp_Query += "role=admin&active=true"

    Raw_Req += "POST /api/v1/users?role=admin&active=true HTTP/1.1\r\n"
    Raw_Req += "Host: localhost:8080\r\n"
    Raw_Req += "Content-Type: application/json\r\n"
    Raw_Req += "\r\n"
    Raw_Req += "{\"name\":\"Loom Developer\"}"

    Req = HttpServer.Parse_Request(Raw_Req)

    Print("Method: ")
    Print(Req.Method)
    Print("\nPath: ")
    Print(Req.Path)
    Print("\nQuery: ")
    Print(Req.Query)
    Print("\nBody: ")
    Print(Req.Body)
    Print("\n")

    If Req.Method == Exp_Method And Req.Path == Exp_Path And Req.Query == Exp_Query
        Print("SUCCESS: Request parsed correctly!\n")
    Else
        Print("FAILURE: Request parsing failed\n")
    End If

    Res = HttpServer.Res_New()
    Res = HttpServer.Res_Status(Res, 201)
    Res = HttpServer.Res_Json(Res, "{\"created\":true}")

    Print("Response status: ")
    Print(Res.Status_Code)
    Print("\nResponse headers:\n")
    Print(Res.Headers)
    Print("Response body:\n")
    Print(Res.Body)
    Print("\n")

    If Res.Status_Code == 201
        Print("SUCCESS: Response built correctly!\n")
    Else
        Print("FAILURE: Response building failed\n")
    End If
End Main
